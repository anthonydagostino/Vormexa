{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vormexa",
  "version": "1.0.0",
  "identifier": "com.vormexa.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Vormexa",
        "width": 1200,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "All-in-one offline media tools.",
    "longDescription": "Compress, convert, resize and merge video, photos, audio and PDFs — 100% on your device. No uploads, complete privacy.",
    "copyright": "© Vormexa",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
