{
  "name": "Vormexa — Media Tools",
  "short_name": "Vormexa",
  "description": "All-in-one offline toolkit to compress, convert, resize & merge video, photos, audio and PDFs. 100% private — nothing leaves your device.",
  "id": "/",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0a12",
  "theme_color": "#4f46e5",
  "categories": ["productivity", "photo", "video", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Compress Video", "url": "/app/video/compress" },
    { "name": "Convert Image", "url": "/app/image/convert" },
    { "name": "Merge PDF", "url": "/app/pdf/merge" }
  ]
}
