{
  "name": "vormexa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vormexa — All-in-one Video, Photo, Audio & PDF tools. Compress, convert, resize & merge. 100% offline & private.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
