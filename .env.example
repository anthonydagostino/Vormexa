# ── Vormexa environment ──────────────────────────────────────────────────────
# Copy to `.env` (or set in your host's dashboard) and fill in.
# All values are PUBLIC (they ship in the client bundle) — never put secret
# API keys here. Payments/licensing use Lemon Squeezy's public license API.

# Hosted checkout link for the Pro plan.
# Create a product in Lemon Squeezy → Share → copy the checkout URL.
VITE_LS_CHECKOUT_URL=

# Optional: customer portal URL (manage subscription / receipts).
VITE_LS_PORTAL_URL=

# Optional: display name for your store.
VITE_LS_STORE_NAME=Vormexa
